# Server .env for infra/docker-compose.prod.yml (staging and production).
# The real file lives only on the server at /opt/onlinedars/.env and in the
# GitHub Environment secret ENV_FILE. Never commit real values.
# Generate secrets with: openssl rand -base64 48

# --- stack ---
COMPOSE_PROJECT_NAME=onlinedars
# Public hostnames Caddy serves (Let's Encrypt certificates are issued automatically)
SITE_DOMAIN=staging.onlinedars.uz
FILES_DOMAIN=files.staging.onlinedars.uz
ACME_EMAIL=admin@example.com
# Set by deploy.sh; the defaults are only for manual `docker compose` runs
IMAGE_PREFIX=ghcr.io/fox3mr3ygu3/onlinedars
IMAGE_TAG=main

# --- postgres ---
POSTGRES_USER=onlinedars
POSTGRES_PASSWORD=change-me
POSTGRES_DB=onlinedars
DATABASE_URL=postgresql://onlinedars:change-me@postgres:5432/onlinedars?schema=public

# --- redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

# --- minio / S3 ---
MINIO_ROOT_USER=onlinedars
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://files.staging.onlinedars.uz
S3_ACCESS_KEY=onlinedars
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=onlinedars

# --- auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# --- SMS (Eskiz.uz) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# --- monitoring ---
SENTRY_DSN=

# --- urls ---
WEB_URL=https://staging.onlinedars.uz
# Server-side calls from Next.js go straight to the api container
API_URL=http://api:4000/api/v1
# Browser calls are same-origin; baked into the web image at build time
NEXT_PUBLIC_API_URL=/api/v1

# Caddy: automatic HTTPS (Let's Encrypt) in front of web, api and file downloads.
# SITE_DOMAIN / FILES_DOMAIN / ACME_EMAIL come from the server .env via docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
	# Nothing sits in front of Caddy, so no trusted_proxies: client-sent X-Forwarded-For is
	# not trusted here. Caddy sets X-Forwarded-For for web/api, which should trust only it.
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip

	# API (/api/v1/...) on the same origin as the web app,
	# so auth cookies stay first-party and the web image is environment-independent.
	handle /api/* {
		request_body {
			max_size 50MB
		}
		reverse_proxy api:4000 {
			health_uri /api/v1/health
			health_interval 15s
		}
	}

	# Next.js immutable build assets
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}

# Presigned downloads/uploads for lesson files, images and certificate PDFs.
# The original Host header is passed through (Caddy's default), which presigned S3 signatures need:
# the api must sign URLs against S3_PUBLIC_URL (https://FILES_DOMAIN).
# No X-Frame-Options here so certificate PDFs can be previewed in an iframe on the site.
{$FILES_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	request_body {
		max_size 200MB
	}
	reverse_proxy minio:9000
}

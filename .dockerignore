# Keep the build context small and free of secrets.
.git
.github
.claude
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/playwright-report
**/test-results
.pnpm-store
docs
infra/data
infra/loadtest
backups
*.log
*.dump
*.sql.gz

# env & secrets: never in an image
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key

# OnlineDars — copy to `.env` (never commit `.env`). Values here are local-dev defaults only.

NODE_ENV=development

# ── Database / cache (infra/docker-compose.yml) ──
POSTGRES_USER=onlinedars
POSTGRES_PASSWORD=onlinedars
POSTGRES_DB=onlinedars
DATABASE_URL=postgresql://onlinedars:onlinedars@localhost:5432/onlinedars?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth (use long random strings: `openssl rand -base64 48`) ──
JWT_ACCESS_SECRET=dev-access-secret-change-me-at-least-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-at-least-32-chars

# ── File storage (MinIO locally, S3-compatible in prod) ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=onlinedars
# Public base URL for objects (CDN or MinIO public URL)
S3_PUBLIC_URL=http://localhost:9000/onlinedars

# ── SMS (Eskiz.uz). Leave empty to log OTP codes to the API console instead. ──
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ── Monitoring (optional; Sentry is off when empty) ──
SENTRY_DSN=
LOG_LEVEL=info

# ── URLs ──
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
# Browser-side API base. Relative: Next.js rewrites /api/v1/* to API_URL (same origin => cookies work).
NEXT_PUBLIC_API_URL=/api/v1
# Extra CORS origins, comma-separated (WEB_URL is always allowed)
CORS_ORIGINS=

# ── Seed (dev only) — password for the seeded admin / content manager / student ──
SEED_PASSWORD=Parol12345!

# ── Payments (server-side only; leave empty to disable a provider) ──
# Payme Merchant API. Register callback URL: <API_URL>/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# true = checkout.test.paycom.uz (sandbox), false = checkout.paycom.uz (production)
PAYME_TEST_MODE=true
# Optional fiscal receipt fields sent in CheckPerformTransaction.detail
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
# Click SHOP-API. Register Prepare URL <API_URL>/payments/click/prepare and Complete URL <API_URL>/payments/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Worker re-checks stuck PENDING payments every N minutes (0 = off)
PAYMENT_RECHECK_INTERVAL_MINUTES=10
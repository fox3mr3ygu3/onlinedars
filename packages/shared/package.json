{
  "name": "@onlinedars/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Enums, constants, error codes and zod schemas shared by web and api",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@onlinedars/eslint-config": "workspace:*",
    "@onlinedars/tsconfig": "workspace:*",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}

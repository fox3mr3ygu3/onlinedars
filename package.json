{
  "name": "onlinedars",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @onlinedars/api db:generate",
    "db:migrate": "pnpm --filter @onlinedars/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @onlinedars/api db:migrate:deploy",
    "db:seed": "pnpm --filter @onlinedars/api db:seed",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}

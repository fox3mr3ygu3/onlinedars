// OnlineDars database schema.
// Hierarchy: Course → Module → Lesson → Practice → Question (CLAUDE.md rule 1).
// The 4 practices × 6 questions rule is enforced by DB triggers in migration 0001_init
// and by the content services. Money is integer tiyin, currency UZS.
// Enum values must match packages/shared/src/enums (checked by a unit test).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── enums ─────────────────────────

enum Role {
  ADMIN
  CONTENT_MANAGER
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  FILL_BLANK
  IMAGE_BASED
}

enum LessonMaterialType {
  TEXT
  IMAGE
  FILE
  VIDEO
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYME
  CLICK
}

enum EnrollmentSource {
  PURCHASE
  FREE
  ADMIN
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  VERIFY_PHONE
}

enum NotificationType {
  PAYMENT_SUCCESS
  CERTIFICATE_ISSUED
  SYSTEM
}

// ───────────────────────── identity ─────────────────────────

model User {
  id              String    @id @default(cuid())
  /// Stored lower-cased.
  email           String?   @unique
  /// Stored as E.164, e.g. +998901234567.
  phone           String?   @unique
  passwordHash    String
  fullName        String
  role            Role      @default(STUDENT)
  isActive        Boolean   @default(true)
  avatarUrl       String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions         Session[]
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  practiceAttempts PracticeAttempt[]
  examAttempts     ExamAttempt[]
  certificates     Certificate[]
  orders           Order[]
  auditLogs        AuditLog[]        @relation("AuditActor")
  notifications    Notification[]
  createdCourses   Course[]          @relation("CourseCreatedBy")
  settingsUpdated  Setting[]

  @@index([role])
  @@index([createdAt])
}

/// One row per signed-in device. The refresh token is `<sessionId>.<secret>`; only an HMAC of
/// the current secret is stored. Each refresh rotates the secret; presenting an old secret
/// (token reuse) revokes the session.
model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// SMS one-time codes (phone sign-up, password reset). Only an HMAC of the code is stored.
model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

// ───────────────────────── catalog ─────────────────────────

model Direction {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@index([isActive, position])
}

model Teacher {
  id        String   @id @default(cuid())
  slug      String   @unique
  fullName  String
  title     String?
  bio       String?
  photoUrl  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]

  @@index([isActive, position])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model Course {
  id                    String       @id @default(cuid())
  slug                  String       @unique
  title                 String
  shortDescription      String       @default("")
  description           String       @default("")
  goals                 String[]     @default([])
  coverImageUrl         String?
  level                 CourseLevel  @default(BEGINNER)
  status                CourseStatus @default(DRAFT)
  isFree                Boolean      @default(false)
  /// Price in tiyin (1 UZS = 100 tiyin). 0 for free courses.
  price                 Int          @default(0)
  currency              String       @default("UZS")
  /// Per-course admin setting: lessons/modules unlock one after another.
  sequentialUnlock      Boolean      @default(true)
  directionId           String?
  certificateTemplateId String?
  createdById           String?
  publishedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  direction           Direction?           @relation(fields: [directionId], references: [id], onDelete: SetNull)
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  teachers            Teacher[]
  modules             Module[]
  enrollments         Enrollment[]
  exam                Exam?
  certificates        Certificate[]
  orders              Order[]

  @@index([status, createdAt])
  @@index([directionId])
}

// ───────────────────────── content ─────────────────────────

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id              String    @id @default(cuid())
  moduleId        String
  title           String
  summary         String?
  durationMinutes Int?
  position        Int
  /// Required lessons gate the final exam.
  isRequired      Boolean   @default(true)
  /// Can only become true when the lesson has exactly 4 practices × 6 questions.
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials LessonMaterial[]
  practices Practice[]
  progress  LessonProgress[]

  @@index([moduleId, position])
}

model LessonMaterial {
  id        String             @id @default(cuid())
  lessonId  String
  type      LessonMaterialType
  title     String?
  /// Sanitised rich text (HTML) for TEXT materials.
  content   String?
  /// S3 object key for uploaded IMAGE / FILE materials.
  fileKey   String?
  fileUrl   String?
  mimeType  String?
  sizeBytes Int?
  videoUrl  String?
  position  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
}

/// Exactly 4 per lesson (max enforced by trigger `practice_limit_per_lesson`).
model Practice {
  id          String   @id @default(cuid())
  lessonId    String
  title       String
  description String?
  position    Int
  isRequired  Boolean  @default(true)
  /// Minimum percent to count as passed; 0 = any submission counts.
  passScore   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  PracticeAttempt[]

  @@index([lessonId, position])
}

/// Exactly 6 per practice (max enforced by trigger `question_limit_per_practice`).
model Question {
  id          String       @id @default(cuid())
  practiceId  String
  type        QuestionType
  /// FILL_BLANK prompts contain placeholders {{0}}, {{1}} …
  prompt      String
  imageUrl    String?
  explanation String?
  /// MULTIPLE_CHOICE / IMAGE_BASED: several options may be correct.
  isMultiple  Boolean      @default(false)
  points      Int          @default(1)
  position    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  practice Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  options  QuestionOption[]
  answers  PracticeAnswer[]

  @@index([practiceId, position])
}

/// Options belong to either a practice Question or an ExamQuestion (exactly one, CHECK constraint).
/// - MULTIPLE_CHOICE / TRUE_FALSE / IMAGE_BASED: `text` + `isCorrect`
/// - MATCHING: `text` (left) paired with `matchText` (right)
/// - FILL_BLANK: `text` is an accepted answer for blank `blankIndex`
/// Never sent to students before submission with isCorrect / matchText / blank answers.
model QuestionOption {
  id             String   @id @default(cuid())
  questionId     String?
  examQuestionId String?
  text           String
  imageUrl       String?
  isCorrect      Boolean  @default(false)
  matchText      String?
  blankIndex     Int?
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  question     Question?     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion? @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@index([examQuestionId, position])
}

// ───────────────────────── learning ─────────────────────────

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  source      EnrollmentSource
  /// The paid order that granted access (PURCHASE only).
  orderId     String?          @unique
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  revokedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id               String    @id @default(cuid())
  userId           String
  lessonId         String
  materialViewedAt DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model PracticeAttempt {
  id           String    @id @default(cuid())
  userId       String
  practiceId   String
  score        Int       @default(0)
  maxScore     Int       @default(0)
  correctCount Int       @default(0)
  totalCount   Int       @default(0)
  passed       Boolean   @default(false)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice         @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  answers  PracticeAnswer[]

  @@index([userId, practiceId])
  @@index([practiceId])
}

model PracticeAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  /// The submitted answer, shape = shared `questionAnswerSchema`.
  answer        Json
  isCorrect     Boolean
  pointsAwarded Int      @default(0)
  createdAt     DateTime @default(now())

  attempt  PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// One final exam per course; settings are admin-configured.
model Exam {
  id               String   @id @default(cuid())
  courseId         String   @unique
  title            String
  /// Questions drawn per attempt from the exam's question pool.
  questionCount    Int
  timeLimitMinutes Int
  /// Percent (1–100) needed to pass.
  passScore        Int
  maxAttempts      Int?
  shuffleQuestions Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]
}

/// The exam's own question pool (separate from practice questions so practice
/// results never reveal exam answers). Options live in QuestionOption.examQuestionId.
model ExamQuestion {
  id          String       @id @default(cuid())
  examId      String
  type        QuestionType
  prompt      String
  imageUrl    String?
  explanation String?
  isMultiple  Boolean      @default(false)
  points      Int          @default(1)
  position    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  exam    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([examId, position])
}

model ExamAttempt {
  id          String            @id @default(cuid())
  examId      String
  userId      String
  status      ExamAttemptStatus @default(IN_PROGRESS)
  /// ExamQuestion ids drawn for this attempt, in display order.
  questionIds Json
  /// Autosaved answers (shared `questionAnswerSchema[]`); graded on submit.
  answers     Json?
  startedAt   DateTime          @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Int?
  maxScore    Int?
  percent     Int?
  passed      Boolean?

  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate Certificate?

  @@index([userId, examId])
  @@index([examId, status])
}

// ───────────────────────── certificates ─────────────────────────

model CertificateTemplate {
  id                 String   @id @default(cuid())
  name               String
  /// HTML with placeholders {{fullName}}, {{courseTitle}}, {{issuedAt}}, {{certificateId}}, {{verifyUrl}}.
  html               String
  backgroundImageUrl String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courses      Course[]
  certificates Certificate[]
}

/// Issued once per (user, course). `publicId` is the ID shown on the PDF and used in /verify/{publicId}.
model Certificate {
  id             String    @id @default(cuid())
  publicId       String    @unique
  userId         String
  courseId       String
  examAttemptId  String?   @unique
  templateId     String?
  /// Snapshots at issue time, so later renames don't change issued certificates.
  fullName       String
  courseTitle    String
  issuedAt       DateTime  @default(now())
  pdfKey         String?
  pdfGeneratedAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  examAttempt ExamAttempt?         @relation(fields: [examAttemptId], references: [id], onDelete: SetNull)
  template    CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
}

// ───────────────────────── payments ─────────────────────────

model Order {
  id          String           @id @default(cuid())
  /// Human-friendly sequential number shown to students and sent to providers.
  number      Int              @unique @default(autoincrement())
  userId      String
  courseId    String
  /// Copied from Course.price at creation (tiyin). Never taken from the client.
  amount      Int
  currency    String           @default("UZS")
  status      PaymentStatus    @default(PENDING)
  provider    PaymentProvider?
  paidAt      DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments   Payment[]
  enrollment Enrollment?

  @@index([userId, createdAt])
  @@index([courseId])
  @@index([status, createdAt])
}

/// One row per provider transaction. Unique (provider, providerTransactionId) makes
/// callbacks idempotent.
model Payment {
  id                    String          @id @default(cuid())
  orderId               String
  provider              PaymentProvider
  providerTransactionId String
  amount                Int
  currency              String          @default("UZS")
  status                PaymentStatus   @default(PENDING)
  /// Provider-side create time in ms (Payme `time`).
  providerCreatedAt     BigInt?
  performedAt           DateTime?
  cancelledAt           DateTime?
  /// Provider-specific cancel reason code.
  cancelReason          Int?
  /// Last raw provider payload, for support/debugging (no secrets).
  raw                   Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([orderId])
  @@index([status, createdAt])
}

// ───────────────────────── platform ─────────────────────────

/// Every admin change to payments (and other sensitive entities) is recorded here.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
